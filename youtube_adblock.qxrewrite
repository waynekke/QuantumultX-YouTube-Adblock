#!name=YouTube移动网页去广告
#!desc=清理YouTube移动网页播放器响应中的广告字段，并拦截明确的广告请求；不适用于YouTube原生应用
#!author=waynekke
#!homepage=https://github.com/waynekke/QuantumultX-YouTube-Adblock
#!version=1.1.0
#!update-interval=86400

hostname = m.youtube.com, www.youtube.com, s.youtube.com

# YouTube移动网页播放器JSON响应：仅处理player接口
^https?:\/\/(m|www)\.youtube\.com\/youtubei\/v1\/player(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/waynekke/QuantumultX-YouTube-Adblock/main/youtube_no_ads.js

# 明确的广告加载与追踪接口
^https?:\/\/(m|www|s)\.youtube\.com\/(pagead|ptracking)(\/|\?|$) url reject-200

# 广告统计接口
^https?:\/\/(m|www|s)\.youtube\.com\/api\/stats\/ads(?:\/)?(?:\?.*)?$ url reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?(?:[^#]*&)?adcontext(?:=|&|$) url reject-200
